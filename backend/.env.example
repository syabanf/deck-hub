# WIT backend — copy to .env and adjust.
#
#   cp .env.example .env
#
# main.go loads .env automatically (best-effort), so nothing else is needed
# locally. Every value below is the default the code already applies, except
# JWT_SECRET — the server refuses to start without one.
#
# .env is gitignored. Keep it that way; only this template is committed.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=wit
DB_PASSWORD=wit
DB_NAME=wit
# `require` in production. `disable` is fine only over a local socket.
DB_SSLMODE=disable

# --- HTTP server ---
HTTP_PORT=8080

# --- Auth ---
# REQUIRED — the server exits at startup if this is empty.
# Generate a real one for anything but local development:
#   openssl rand -base64 48
JWT_SECRET=dev-insecure-change-me

# Token lifetime as a Go duration (15m, 24h, 720h…). Longer means fewer
# sign-ins, and a longer window in which a stolen token still works.
JWT_TTL=24h

# --- CORS ---
# Comma-separated browser origins allowed to call this API. The defaults cover
# the Vite dev server and the production-preview server.
#
# Set this to the PWA's real origin when deploying. A wrong value shows up as a
# blocked request in the browser with nothing in the server log to explain it.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Frontend origin ---
# Where verification emails point: the backend appends /verify?token=… to it.
# This must be an origin the recipient can actually open — not the API's own
# address. Left at the default in production, every verification email would
# send people to their own machine.
APP_BASE_URL=http://localhost:5173

# --- Uploads (local filesystem storage) ---
# Directory files are written to and served from at /uploads/<name>.
# Not disposable: deleting it breaks every deck that references an uploaded
# file, so mount a volume rather than a container-local path.
UPLOAD_DIR=./uploads

# Maximum size of a single upload, in megabytes. Anything larger gets a 413.
MAX_UPLOAD_MB=25
