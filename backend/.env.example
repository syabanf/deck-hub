# Copy to .env and adjust. main.go loads .env automatically (best-effort).

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=wit
DB_PASSWORD=wit
DB_NAME=wit
DB_SSLMODE=disable

# --- HTTP server ---
HTTP_PORT=8080

# --- Auth ---
# REQUIRED. Use a long random string in production, e.g.:
#   openssl rand -base64 48
JWT_SECRET=dev-insecure-change-me
# Token lifetime as a Go duration (e.g. 15m, 24h, 720h).
JWT_TTL=24h

# --- CORS ---
# Comma-separated browser origins allowed to call the API. Defaults cover the
# Vite dev server and the production-preview server; set this explicitly to the
# PWA's real origin when deploying.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Uploads (local filesystem storage) ---
# Directory uploaded files are written to and served from at /uploads/<name>.
UPLOAD_DIR=./uploads
# Maximum size of a single upload, in megabytes.
MAX_UPLOAD_MB=25
