# Copy to .env and adjust. main.go loads .env automatically (best-effort).

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=wit
DB_PASSWORD=wit
DB_NAME=wit
DB_SSLMODE=disable

# --- HTTP server ---
HTTP_PORT=8080

# --- Auth ---
# REQUIRED. Use a long random string in production, e.g.:
#   openssl rand -base64 48
JWT_SECRET=dev-insecure-change-me
# Token lifetime as a Go duration (e.g. 15m, 24h, 720h).
JWT_TTL=24h
