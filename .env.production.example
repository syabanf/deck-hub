# WIT production — copy to .env on the deploy host and fill in.
#
#   cp .env.production.example .env
#   docker compose -f docker-compose.ghcr.yml up -d
#
# Compose reads .env from the directory it runs in. These variables configure
# the containers; they are NOT the same file as backend/.env, which is for
# running the API straight from source.
#
# Five of them have no default and compose refuses to start without them. That
# is deliberate: each one is a setting whose absence is invisible until it has
# already caused damage.

# --- Image selection ---
# Pin a version tag that CI published, not `latest`. Rolling back is then
# editing this line and running `up -d` again.
GHCR_IMAGE_PREFIX=ghcr.io/syabanf/deck-hub
IMAGE_TAG=v0.1.0

# Port the frontend container publishes on the host. Put a TLS terminator in
# front of it — the container itself speaks plain HTTP and knows nothing about
# certificates.
APP_PORT=8080

# --- Database ---
DB_USER=wit
DB_NAME=wit
# REQUIRED. openssl rand -hex 24
DB_PASSWORD=

# --- Auth ---
# REQUIRED. openssl rand -base64 48
# Changing it invalidates every token in circulation, signing everyone out.
JWT_SECRET=
JWT_TTL=24h

# --- Public origin ---
# REQUIRED, both of them, and both the https:// origin visitors actually type.
# CORS_ORIGINS wrong: the browser blocks every call and the server log says
# nothing. APP_BASE_URL wrong: verification emails point somewhere nobody can
# open.
CORS_ORIGINS=https://paparan.reddie.id
APP_BASE_URL=https://paparan.reddie.id

# --- Bootstrap admin ---
# REQUIRED. Migration 000001 seeds this account with a password published in
# the repository; setting one here rotates it at every boot. Without it,
# anyone who can read the source is an admin on the live site.
BOOTSTRAP_ADMIN_EMAIL=admin@wit.id
BOOTSTRAP_ADMIN_PASSWORD=

# --- Email ---
# Registration is open. Leave SMTP_HOST empty and verification links are
# printed to the container log instead of being sent, so nobody who signs up
# can finish.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=WIT <no-reply@paparan.reddie.id>

# --- Auth rate limits, per minute ---
# Per calling address and per account named in the body, both enforced. Raise
# the first if a whole office shares one public address.
AUTH_RATE_IP=10
AUTH_RATE_ACCOUNT=5

# --- Uploads ---
# Lives on the uploads_data volume. Not disposable: deleting it breaks every
# deck that points at an uploaded file. Back it up with the database.
MAX_UPLOAD_MB=25
