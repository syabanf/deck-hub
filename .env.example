# WIT frontend — copy to .env and adjust.
#
#   cp .env.example .env
#
# Vite only exposes variables prefixed VITE_ to the browser. That prefix is the
# safety boundary: anything carrying it is compiled into a public bundle and is
# readable by anyone who opens devtools. Never put a secret here.
#
# .env is gitignored. Only this template is committed.

# --- API location ---
# Where the browser sends API calls. Baked in at BUILD time, not read at
# runtime, so changing it means rebuilding — not just restarting.
#
# Local development, with the Go API on its own port:
VITE_API_URL=http://localhost:8080

# In production the API is proxied under the same origin, so this becomes a
# path rather than an absolute URL. That keeps every call same-origin: no CORS
# preflight, and no mixed-content block when the page is served over HTTPS.
#
#   VITE_API_URL=/api
#
# Build with it set, or the default in src/lib/api.js applies and the deployed
# bundle points every visitor at their own machine:
#
#   VITE_API_URL=/api npm run build
