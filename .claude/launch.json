{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wit",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "wit-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--", "--port", "4173"],
      "port": 4173
    },
    {
      "name": "wit-api",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "cd backend && PATH=/opt/homebrew/bin:$PATH exec go run ./cmd/api"],
      "port": 8080
    }
  ]
}
